@article{bogdanova2022influence-70f,
  title = {Influence of Cooling Rate on Ice Crystallization and Melting in Sucrose-Water System},
  author = {Bogdanova, Ekaterina and Fureby, Anna Millqvist and Kocherbitov, Vitaly},
  year = 2022,
  journal = {Journal of Pharmaceutical Sciences},
  volume = {111},
  number = {7},
  pages = {2030--2037},
  issn = {0022-3549},
  doi = {10.1016/j.xphs.2022.01.027},
  abstract = {The ice crystallization and melting in systems where the equilibrium state is difficult to reach is one of the growing areas in pharmaceutical freeze-drying research. The quality of the final freeze-dried product depends on the parameters of the cooling step, which affect the ice nucleation and growth. In this paper, we present a DSC study of ice crystallization and melting in a sucrose-water system. Using two different types of thermal cycles, we examine the influence of cooling and heating rates on the thermal behavior of sucrose-water solutions with water contents between 50 and 100 wt\%. The DSC results show that low cooling rates provide crystallization at higher temperatures and lead to lower amount of non-freezing water. Consequently, the glass transition and ice melting properties observed upon heating depend on the cooling conditions in the preceding step. Based on the experimental results, we investigate the reasons for the existence of the two steps on DSC heating curves in sucrose-water systems: the glass transition step and the onset of ice melting. We show that diffusion of water can be the limiting factor for ice growth and melting in the sucrose-water system when the amorphous phase is in a liquid state. In particular, when the diffusion coefficient drops below 10-14 m2/sec, the ice crystals growth or melting becomes strongly suppressed even above the glass transition temperature. Understanding the diffusion limitations in the sucrose-water system can be used for the optimization of the freeze-drying protocols for proteins and probiotics.},
  pmid = {35120964}
}

@article{briardsmall2016,
  title = {Small Molecule Ice Recrystallization Inhibitors Mitigate Red Blood Cell Lysis during Freezing, Transient Warming and Thawing.},
  author = {Briard, Jennie G and Capicciotti, Chantelle J and Acker, Jason P and Ben, Robert N and Poisson, Jessica S and Turner, Tracey R},
  year = 2016,
  journal = {Scientific Reports},
  volume = {6},
  number = {1},
  doi = {10.1038/srep23619},
  abstract = {During cryopreservation, ice recrystallization is a major cause of cellular damage. Conventional cryoprotectants such as dimethyl sulfoxide (DMSO) and glycerol function by a number of different mechanisms but do not mitigate or control ice recrystallization at concentrations utilized in cryopreservation procedures. In North America, cryopreservation of human red blood cells (RBCs) utilizes high concentrations of glycerol. RBC units frozen under these conditions must be subjected to a time-consuming deglycerolization process after thawing in order to remove the glycerol to \textexclamdown 1\% prior to transfusion thus limiting the use of frozen RBC units in emergency situations. We have identified several low molecular mass ice recrystallization inhibitors (IRIs) that are effective cryoprotectants for human RBCs, resulting in 70--80\textbackslash{} \% intact RBCs using only 15\textbackslash{} \% glycerol and slow freezing rates. These compounds are capable of reducing the average ice crystal size of extracellular ice relative to a 15\textbackslash{} \% glycerol control validating the positive correlation between a reduction in ice crystal size and increased post-thaw recovery of RBCs. The most potent IRI from this study is also capable of protecting frozen RBCs against the large temperature fluctuations associated with transient warming.}
}

