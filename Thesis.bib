@article{Rothschild2001,
  title = {Life in Extreme Environments},
  author = {Rothschild, Lynn J. and Mancinelli, Rocco L.},
  year = 2001,
  journal = {Nature},
  volume = {409},
  number = {6823},
  pages = {1092--1101},
  issn = {0028-0836},
  doi = {10.1038/35059215},
  abstract = {Each recent report of liquid water existing elsewhere in the Solar System has reverberated through the international press and excited the imagination of humankind. Why? Because in the past few decades we have come to realize that where there is liquid water on Earth, virtually no matter what the physical conditions, there is life. What we previously thought of as insurmountable physical and chemical barriers to life, we now see as yet another niche harbouring 'extremophiles'. This realization, coupled with new data on the survival of microbes in the space environment and modelling of the potential for transfer of life between celestial bodies, suggests that life could be more common than previously thought. Here we examine critically what it means to be an extremophile, and the implications of this for evolution, biotechnology and especially the search for life in the Universe.},
  pmid = {11234023}
}

@article{ruizmatus2025thermodynamics-981,
  title = {Thermodynamics of the Supplemented Phase Diagram. {{An}} Approach through Transport Coefficients},
  author = {{Ruiz-Matus}, Soledad and Andraca, Adriana and Goldstein, Patricia},
  year = 2025,
  journal = {Essential Chem},
  volume = {2},
  number = {1},
  pages = {1--17},
  doi = {10.1080/28378083.2025.2464144},
  abstract = {At present, the physical description of the glass transition may be considered as one of the most important problems in soft matter physics. This kinetic transition appears both through supercooling a simple liquid or lowering a supersaturated aqueous mixture temperatures far below freezing. For almost a century, several efforts have been developed to present a thermodynamic-like phase diagram of several non eutectic aqueous solutions to artificially cryo protect biological tissues. Since the introduction of the so-called supplemented phase diagrams, the description of their equilibrium and nonequilibrium regions remains an unsettled issue. In this work we present a relaxation analysis for these diagrams in terms of the description of the viscosity in the supersaturated non equilibrium regime.}
}

