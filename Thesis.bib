@article{liraman2016,
  title = {Raman Spectroscopic Studies of Clathrate Hydrate Formation in the Presence of Hydrophobized Particles.},
  author = {Li, Huijuan and Wang, Liguang and Aman, Zachary and Stanwix, Paul and May, Eric and Johns, Michael},
